# Copy this file to ".env" in the repo root and fill it in.
# .env is gitignored: never commit real keys.

# --- Neo4j ---------------------------------------------------------------
# read by docker compose and by the Python scripts (settings.py)
NEO4J_PASSWORD=yourpassword
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- ChromaDB ------------------------------------------------------------
# read by every Python script that talks to Chroma (settings.py)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- LLM API keys (only for extraction / generation) ----------------------
# Extracting/tutorial_chunks.py (loads this .env by itself)
GEMINI_API_KEY=
# Extracting/pyqs_processing/pdf_extract_full.py, and question drafting (below)
OPENROUTER_API_KEY=
# Extracting/pyqs_processing/model_search.py
GROQ_API_KEY=

# --- Question drafting (pipeline/llm.py, read through settings.py) ---------
# Any OpenAI-compatible service. Left empty = OpenRouter with the
# OPENROUTER_API_KEY above and the model below.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Free model ids come and go. If you get "the model id or the base URL is
# wrong", pick a current one at https://openrouter.ai/models (free filter).
# To use Groq instead (list its models: python Extracting/pyqs_processing/model_search.py):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=<a model id from that list>
#   LLM_API_KEY=<your GROQ key>
# LLM_TIMEOUT=180      seconds to wait for one reply
# The model that checks each draft and classifies it (empty = the drafting
# model). A second model catches more of the first one's mistakes. Same service
# and key, unless the next two are set: then it is another service with its OWN
# free daily budget (e.g. drafting on Groq, checking on OpenRouter or Gemini).
LLM_CHECK_MODEL=
LLM_CHECK_BASE_URL=
LLM_CHECK_API_KEY=
# How long a reasoning model (gpt-oss, Gemini) may think: low (the default) |
# medium | high | default (not sent: the service decides). Thinking tokens count
# against the daily token limit; low saves the most. Models that do not reason:
# it is dropped after their first refusal.
LLM_REASONING_EFFORT=low
# balanced (default): the question must be correct and built on the sources, and
#   may use standard course facts they do not state; the answer is a draft key.
# strict: every fact in the question and the answer quoted from a source.
GROUNDING=balanced

# NOTE: the Neo4j, Chroma and LLM_* settings are read from this file
# (settings.py), and so is OPENROUTER_API_KEY for drafting. pdf_extract_full.py
# and model_search.py do NOT read this file: they need the key set in the
# terminal. In PowerShell:
#   $env:OPENROUTER_API_KEY = "sk-..."
# A value set in the terminal always wins over this file.
