# Copy this file to ".env" in the repo root and fill it in.
# .env is gitignored: never commit real keys.

# --- Neo4j ---------------------------------------------------------------
# docker compose reads this automatically from .env
NEO4J_PASSWORD=yourpassword
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- ChromaDB ------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- LLM API keys (only for extraction / generation) ----------------------
# Extracting/tutorial_chunks.py (loads this .env by itself)
GEMINI_API_KEY=
# Extracting/pyqs_processing/pdf_extract_full.py
OPENROUTER_API_KEY=
# Extracting/pyqs_processing/model_search.py
GROQ_API_KEY=

# NOTE: apart from docker compose and tutorial_chunks.py, the Python scripts
# read real environment variables, not this file. In PowerShell:
#   $env:OPENROUTER_API_KEY = "sk-..."
